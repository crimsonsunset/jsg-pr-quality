{
  "name": "@crimsonsunset/eslint-config",
  "version": "0.1.0",
  "description": "Shared ESLint flat config base for crimsonsunset TypeScript repos",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./type-checked": "./type-checked.mjs"
  },
  "files": [
    "index.mjs",
    "type-checked.mjs"
  ],
  "keywords": [
    "eslint",
    "eslintconfig"
  ],
  "dependencies": {
    "eslint-config-prettier": ">=10.0.0"
  },
  "peerDependencies": {
    "@eslint/js": ">=10.0.0",
    "eslint": ">=10.0.0",
    "typescript-eslint": ">=8.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crimsonsunset/jsg-pr-quality.git"
  },
  "bugs": {
    "url": "https://github.com/crimsonsunset/jsg-pr-quality/issues"
  },
  "homepage": "https://github.com/crimsonsunset/jsg-pr-quality#readme",
  "author": "Joe Sangiorgio <jsangio1@gmail.com>"
}
