{
  "name": "jsg-pr-quality",
  "version": "0.1.9",
  "private": true,
  "description": "Reusable PR quality workflows, shareable lint/format configs, and adoption tooling",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "ci:lint": "node scripts/ci/lint.script.mjs",
    "ci:test": "node scripts/ci/test.script.mjs",
    "lint:eslint": "eslint packages scripts",
    "lint:cspell": "cspell \"**/*.{mjs,js,md,json,yml}\" --no-progress",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:knip": "knip"
  },
  "devDependencies": {
    "@crimsonsunset/cspell-config": "*",
    "@crimsonsunset/eslint-config": "*",
    "@crimsonsunset/prettier-config": "*",
    "@eslint/js": "^10.0.1",
    "cspell": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-unicorn": "^73.0.0",
    "knip": "^5.88.1",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.46.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crimsonsunset/jsg-pr-quality.git"
  },
  "bugs": {
    "url": "https://github.com/crimsonsunset/jsg-pr-quality/issues"
  },
  "homepage": "https://github.com/crimsonsunset/jsg-pr-quality#readme",
  "author": "Joe Sangiorgio <jsangio1@gmail.com>"
}
